# Зависимости и сборка
node_modules/
dist/
build/
.vite/

# Секреты: токен бота, токен туннеля, JWT_SECRET, ключи Telegram API.
# Правило намеренно широкое — ловит и .env.production, и .env.local,
# и резервные копии вида .env.bak-20260826. Наружу выходят только шаблоны.
.env*
!.env.example
!.env.*.example
*.bak-*

# Локальные бинарники (cloudflared ~38 МБ — ставится отдельно, см. DEPLOY.md)
.tools/

# Дампы БД (scripts/backup-db.sh). Содержат персональные данные учеников —
# никогда не в репозиторий.
backups/

# Исходники, которые приносит преподаватель: рукописные планы курсов, сканы,
# фотографии. Большие (десятки мегабайт) и попадают сюда по одному разу —
# в публичной истории им делать нечего, а вычистить оттуда файл потом больно.
# Спецификация в docs/ уже отслеживается, поэтому правило её не затрагивает.
/*.pdf
/*.jpg
/*.jpeg
/*.png
/*.heic

# Локальные настройки инструментов, специфичные для машины
.claude/settings.local.json

*.log
.DS_Store

# Кэш снапшотов playwright-cli (визуальная отладка)
.playwright-cli/
