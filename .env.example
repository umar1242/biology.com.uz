# Root .env — read by both docker-compose.yml (dev) and
# docker-compose.prod.yml. Copy to .env and fill in real values.

# From https://my.telegram.org/apps — needed by the local telegram-bot-api
# server (raises the bot's upload limit from 50MB to 2GB).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Only needed for docker-compose.prod.yml's cloudflared service — see
# DEPLOY.md for how to get this from the Cloudflare Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
