# Copy to apps/api/.env.production and fill in real values.
# Used by the `api` service in docker-compose.prod.yml (docker compose
# env_file) — hostnames below are compose service names, not localhost.

# The password here MUST match POSTGRES_PASSWORD in the root .env (that's the
# password the postgres container is created with). Replace both `postgres`
# passwords below with the real value — do not ship the default.
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/course_platform
JWT_SECRET=replace-with-a-long-random-string
PORT=3000

# Owner's personal Telegram numeric ID — the only account allowed to use
# the bot's admin commands (create/list teachers).
OWNER_TELEGRAM_ID=

TELEGRAM_BOT_TOKEN=
# Local Bot API server's internal compose address (raises the 50MB upload
# limit to 2GB) — port 8081 is the container's own port, not the host
# mapping used in the dev docker-compose.yml.
TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081

# Leave unset — webhook mode isn't used in this deployment (see DEPLOY.md).
TELEGRAM_WEBHOOK_SECRET=

# No public URL needed for the bot itself.
BOT_UPDATES_MODE=polling

# Public https origins. MINIAPP_URL is where the bot's "заполнить анкету"
# button opens the Mini App — Telegram rejects non-https here.
MINIAPP_URL=https://app.biolog.com.uz
DASHBOARD_URL=https://admin.biolog.com.uz
