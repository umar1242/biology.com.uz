DATABASE_URL=postgres://postgres:postgres@localhost:5432/course_platform
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# Owner's personal Telegram numeric ID — the only account allowed to use the
# bot's admin commands (create/list teachers). See idea-platforma-kursy.md §2.1.
OWNER_TELEGRAM_ID=

TELEGRAM_BOT_TOKEN=
# Base URL of the local Bot API server (raises the 50MB upload limit to 2GB).
TELEGRAM_BOT_API_URL=http://localhost:8081
TELEGRAM_WEBHOOK_SECRET=change-me
