:80 {
	encode gzip

	# See the dashboard Caddyfile: the tunnel speaks plain HTTP to this
	# container, so the edge's X-Forwarded-Proto is the only signal of how
	# the visitor actually connected. Telegram opens Mini Apps over https
	# anyway, but a hand-typed http:// link must not stay unencrypted.
	@insecure header X-Forwarded-Proto http
	redir @insecure https://{host}{uri} permanent

	# Security headers. Deliberately NO X-Frame-Options / frame-ancestors:
	# Telegram opens the Mini App inside its own iframe (web clients), and
	# a framing restriction here would break it. The rest are safe to send.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/v1/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
