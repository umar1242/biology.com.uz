:80 {
	encode gzip

	# Как в двух других Caddyfile: туннель говорит с контейнером по plain
	# HTTP, поэтому X-Forwarded-Proto от края — единственный признак того,
	# как посетитель пришёл на самом деле. Ссылку, набранную как http://,
	# нельзя оставлять незашифрованной.
	# www и голый домен отдавали одно и то же с кодом 200: для поисковика
	# это две разные страницы с одинаковым содержимым. Канонический адрес —
	# без www, он же стоит в og:url и в rel=canonical.
	@www host www.biolog.com.uz
	redir @www https://biolog.com.uz{uri} permanent

	@insecure header X-Forwarded-Proto http
	redir @insecure https://{host}{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Страницы не должны кэшироваться нигде: ни в браузере, ни на краю
	# Cloudflare. no-cache разрешает хранить копию при условии проверки, и
	# один из узлов Cloudflare этим воспользовался — посетители рядом с ним
	# несколько часов видели откатанную версию. no-store запрещает хранить
	# вовсе, а CDN-Cache-Control говорит то же самое отдельно краю, потому
	# что для статики он подставляет собственные правила поверх наших.
	@pages path / /uz /uz/ *.html
	header @pages {
		Cache-Control "no-store"
		CDN-Cache-Control "no-store"
	}

	# Витрина — один статический файл, без SPA-роутинга: 404 здесь должен
	# оставаться 404, а не молча отдавать главную.
	root * /srv
	file_server
	handle_errors {
		respond "Страница не найдена" {http.error.status_code}
	}
}
